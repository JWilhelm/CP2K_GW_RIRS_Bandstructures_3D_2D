&GLOBAL
  PROJECT 2D_MoS2_aug-SZ2_k16
  PRINT_LEVEL MEDIUM
  RUN_TYPE ENERGY
&END GLOBAL
&FORCE_EVAL
  &DFT
    BASIS_SET_FILE_NAME BASIS_AUG_MOLOPT_GTH
    POTENTIAL_FILE_NAME GTH_SOC_POTENTIALS
    SORT_BASIS EXP
    &KPOINTS
      SCHEME MONKHORST-PACK 16 16 1
      PARALLEL_GROUP_SIZE -1
    &END KPOINTS
    &MGRID
      CUTOFF 500
      REL_CUTOFF 100
    &END MGRID
    &POISSON
      PERIODIC XY
      PSOLVER ANALYTIC
    &END POISSON
    &QS
      METHOD GAPW
      EPS_DEFAULT 1.0E-12
      EPS_PGF_ORB 1.0E-12
    &END QS
    &SCF
      ADDED_MOS -1
      EPS_SCF 1.0E-9
      MAX_SCF 500
      &MIXING
        METHOD BROYDEN_MIXING
        ALPHA 0.1
        BETA 1.5
        NBROYDEN 8
      &END MIXING
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &PROPERTIES
    &BANDSTRUCTURE
      &GW
        &AUTO_RI
        &END AUTO_RI
        &RI_RS
          &GRID_OPTIMIZATION
          &END GRID_OPTIMIZATION
        &END RI_RS
      &END GW
      &SOC
      &END SOC
      &BANDSTRUCTURE_PATH
        NPOINTS 49
        SPECIAL_POINT GAMMA 0.0 0.0 0.0
        SPECIAL_POINT K     0.333333 0.333333 0.0
        SPECIAL_POINT M     0.0 0.5 0.0
        SPECIAL_POINT GAMMA 0.0 0.0 0.0
      &END BANDSTRUCTURE_PATH
    &END BANDSTRUCTURE
  &END PROPERTIES
  &SUBSYS
    &CELL
      ABC                 3.184	3.184 15.0
      ALPHA_BETA_GAMMA    90 90 120
      PERIODIC XY
    &END CELL
    &COORD
      Mo       0.00000000       0.00000000       9.06355632
      S        1.59203323       0.91916082      10.62711265
      S        1.59203323       0.91916082       7.50000000
    &END COORD
    &KIND S
      BASIS_SET aug-SZV-MOLOPT-GTH-tier-2
      POTENTIAL GTH-PBE-q6
    &END KIND
    &KIND Mo
      BASIS_SET aug-SZV-MOLOPT-GTH-tier-2
      POTENTIAL GTH-PBE-q14
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
