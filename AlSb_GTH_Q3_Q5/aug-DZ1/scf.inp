&GLOBAL
  PROJECT SCF34_dz1_AlSb
  PRINT_LEVEL MEDIUM
  RUN_TYPE ENERGY
&END GLOBAL
&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME /scratch/hpc-prf-metdyn/eprop2d1_Jan/06_CP2K_development/gw34_dz12_qcompare_metdyn_6n6h_20261018_v1/runs/AlSb/dz1/low/BASIS
    POTENTIAL_FILE_NAME /scratch/hpc-prf-metdyn/eprop2d1_Jan/06_CP2K_development/gw34_dz12_qcompare_metdyn_6n6h_20261018_v1/runs/AlSb/dz1/low/POTENTIALS
    WFN_RESTART_FILE_NAME /scratch/hpc-prf-metdyn/eprop2d1_Jan/06_CP2K_development/gw34_dz12_qcompare_metdyn_6n6h_20261018_v1/runs/AlSb/dz1/low/SCF_RESTART.kp
    SORT_BASIS EXP
    &POISSON
      PERIODIC XYZ
      POISSON_SOLVER PERIODIC
    &END POISSON
    &KPOINTS
      PARALLEL_GROUP_SIZE -1
      SCHEME MONKHORST-PACK 12 12 12
    &END KPOINTS
    &MGRID
      CUTOFF 1800
      REL_CUTOFF 100
    &END MGRID
    &QS
      EPS_DEFAULT 1.0E-12
      EPS_PGF_ORB 1.0E-12
      METHOD GPW
    &END QS
    &SCF
      ADDED_MOS -1
      EPS_EIGVAL 1.0E-12
      EPS_SCF 1.0E-7
      MAX_SCF 500
      SCF_GUESS RESTART
      &MIXING
        METHOD BROYDEN_MIXING
        ALPHA 0.1
        BETA 1.5
        NBROYDEN 8
      &END MIXING
      &PRINT
        &RESTART ON
        &END RESTART
      &END PRINT
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      CANONICALIZE F
      A 0 3.06775 3.06775
      B 3.06775 0 3.06775
      C 3.06775 3.06775 0
      PERIODIC XYZ
    &END CELL
    &COORD
      SCALED T
      Al 0 0 0
      Sb 0.25 0.25 0.25
    &END COORD
    &KIND Al
      BASIS_SET aug-DZVP-MOLOPT-GTH-tier-1
      POTENTIAL GTH-PBE-q3
    &END KIND
    &KIND Sb
      BASIS_SET aug-DZVP-MOLOPT-GTH-tier-1
      POTENTIAL GTH-PBE-q5
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
