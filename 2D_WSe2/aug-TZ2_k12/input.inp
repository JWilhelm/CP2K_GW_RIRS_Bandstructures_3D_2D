&GLOBAL
  PROJECT WSe2_05_aug-TZVP_T2_k12
  PRINT_LEVEL MEDIUM
  RUN_TYPE ENERGY
  &TIMINGS
     THRESHOLD 0.0001
  &END
&END GLOBAL
&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME /scratch/hpc-prf-metdyn/eprop2d1_Jan/06_CP2K_development/tmdc_five_bases_k12_k16_20261020_v2/data/BASIS
    SORT_BASIS EXP
    POTENTIAL_FILE_NAME /scratch/hpc-prf-metdyn/eprop2d1_Jan/06_CP2K_development/tmdc_five_bases_k12_k16_20261020_v2/data/POTENTIALS
    CHARGE 0
    &MGRID
      CUTOFF  500
      REL_CUTOFF  100
    &END MGRID
    &POISSON
      PERIODIC XY
      PSOLVER ANALYTIC
    &END POISSON
    &QS
      METHOD GAPW
      EPS_DEFAULT 1.0E-12
      EPS_PGF_ORB 1.0E-12
    &END QS
    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-9
      MAX_SCF 500
      &PRINT
        &RESTART ON
        &END
      &END
      ADDED_MOS -1
      &MIXING
          METHOD BROYDEN_MIXING
          ALPHA 0.1
          BETA 1.5
          NBROYDEN 8
      &END
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
    &KPOINTS
      SCHEME MONKHORST-PACK 12 12 1
      PARALLEL_GROUP_SIZE   -1
    &END KPOINTS
  &END DFT
  &PROPERTIES
    &BANDSTRUCTURE

      &GW
        NUM_TIME_FREQ_POINTS 30
        FREQ_MAX_FIT 27.211
        EPS_FILTER 1.0E-11
        RI_CUTOFF_ATTENUATION [bohr^-1] 0.3
        RI_METRIC_BODY_CUTOFF 1.0E-10
        &AUTO_RI
          OPTIMIZE_CONDNUM_RI_METRIC TRUE
          RI_AO_RATIO 3.0
          RI_INITIAL -1
        &END AUTO_RI
        &RI_RS
          TIKHONOV 1.0E-4
          &GRID_OPTIMIZATION
            CUTOFF_ATOMIC_CLUSTER [angstrom] 3.0
            MAX_ITER 20
            RS_AO_RATIO 6
          &END GRID_OPTIMIZATION
        &END RI_RS
      &END GW
      &SOC
        SOC_WINDOW_OCC 10
        SOC_WINDOW_VIRT 10
      &END SOC
      &BANDSTRUCTURE_PATH
        NPOINTS 49
        SPECIAL_POINT GAMMA 0.0 0.0 0.0
        SPECIAL_POINT K     0.333333 0.333333 0.0
        SPECIAL_POINT M     0.0 0.5 0.0
        SPECIAL_POINT GAMMA 0.0 0.0 0.0
      &END
    &END
  &END PROPERTIES
  &SUBSYS
    &CELL
      ABC                 3.319 3.319 15.0
      ALPHA_BETA_GAMMA    90 90 120
      PERIODIC XY
    &END CELL

    &KIND Se
      BASIS_SET ORB aug-TZVP-MOLOPT-GTH-tier-2
      POTENTIAL        GTH-PBE-q6
    &END KIND

    &KIND W
      BASIS_SET ORB aug-TZVP-MOLOPT-GTH-tier-2
      POTENTIAL        GTH-PBE-q14
    &END KIND



    &COORD
       W 0.0 0.0 2.1792764
       Se 1.65950331 0.95811468 3.8585528
       Se 1.65950331 0.95811468 0.5
    &END COORD
  &END SUBSYS
&END FORCE_EVAL
