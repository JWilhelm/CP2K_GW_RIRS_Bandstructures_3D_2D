&GLOBAL
  PROJECT GW5_CdS_wz_q20_sz2
  PRINT_LEVEL MEDIUM
  RUN_TYPE ENERGY
&END GLOBAL
&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME BASIS_AUG_MOLOPT_GTH
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    SORT_BASIS EXP
    &POISSON
      PERIODIC XYZ
      POISSON_SOLVER PERIODIC
    &END POISSON
    &KPOINTS
      PARALLEL_GROUP_SIZE -1
      SCHEME MONKHORST-PACK 12 12 12
    &END KPOINTS
    &MGRID
      CUTOFF 1800
      REL_CUTOFF 100
    &END MGRID
    &QS
      EPS_DEFAULT 1.0E-12
      EPS_PGF_ORB 1.0E-12
      METHOD GPW
    &END QS
    &SCF
      ADDED_MOS -1
      EPS_EIGVAL 1.0E-12
      EPS_SCF 1.0E-7
      MAX_SCF 500
      SCF_GUESS ATOMIC
      &MIXING
        METHOD BROYDEN_MIXING
        ALPHA 0.1
        BETA 1.5
        NBROYDEN 8
      &END MIXING
      &PRINT
        &RESTART ON
        &END RESTART
      &END PRINT
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      CANONICALIZE F
      A 4.136000000000 0.000000000000 0.000000000000
      B -2.068000000000 3.581881070052 0.000000000000
      C 0.000000000000 0.000000000000 6.713000000000
      PERIODIC XYZ
    &END CELL
    &COORD
      SCALED T
      Cd 0.333333333333 0.666666666667 0.000000000000
      Cd 0.666666666667 0.333333333333 0.500000000000
      S 0.333333333333 0.666666666667 0.377150000000
      S 0.666666666667 0.333333333333 0.877150000000
    &END COORD
    &KIND Cd
      BASIS_SET aug-SZV-MOLOPT-GTH-tier-2-q20
      POTENTIAL GTH-PBE-q20
      POTENTIAL_FILE_NAME POTENTIAL_UZH
    &END KIND
    &KIND S
      BASIS_SET aug-SZV-MOLOPT-GTH-tier-2
      POTENTIAL GTH-PBE-q6
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
