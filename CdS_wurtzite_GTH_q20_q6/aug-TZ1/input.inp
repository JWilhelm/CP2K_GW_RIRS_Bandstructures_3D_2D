&GLOBAL
  PROJECT CdS_wurtzite_GTH_q20_q6_aug-TZ1
  PRINT_LEVEL MEDIUM
  RUN_TYPE ENERGY
&END GLOBAL
&FORCE_EVAL
  &DFT
    BASIS_SET_FILE_NAME BASIS_AUG_MOLOPT_GTH
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    SORT_BASIS EXP
    &KPOINTS
      SCHEME MONKHORST-PACK 12 12 12
      PARALLEL_GROUP_SIZE -1
    &END KPOINTS
    &MGRID
      CUTOFF 1800
      REL_CUTOFF 100
    &END MGRID
    &QS
      EPS_DEFAULT 1.0E-12
      EPS_PGF_ORB 1.0E-12
    &END QS
    &SCF
      ADDED_MOS -1
      EPS_EIGVAL 1.0E-12
      EPS_SCF 1.0E-7
      MAX_SCF 500
      &MIXING
        METHOD BROYDEN_MIXING
        ALPHA 0.1
        BETA 1.5
        NBROYDEN 8
      &END MIXING
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &PROPERTIES
    &BANDSTRUCTURE
      &GW
        &AUTO_RI
        &END AUTO_RI
        &RI_RS
          &GRID_OPTIMIZATION
          &END GRID_OPTIMIZATION
        &END RI_RS
      &END GW
      &BANDSTRUCTURE_PATH
        NPOINTS 32
        SPECIAL_POINT GAMMA 0 0 0
        SPECIAL_POINT M 0.5 0 0
        SPECIAL_POINT K 0.333333333333 0.333333333333 0
        SPECIAL_POINT GAMMA 0 0 0
        SPECIAL_POINT A 0 0 0.5
        SPECIAL_POINT L 0.5 0 0.5
        SPECIAL_POINT H 0.333333333333 0.333333333333 0.5
        SPECIAL_POINT A 0 0 0.5
      &END BANDSTRUCTURE_PATH
    &END BANDSTRUCTURE
  &END PROPERTIES
  &SUBSYS
    &CELL
      CANONICALIZE F
      A 4.136000000000 0.000000000000 0.000000000000
      B -2.068000000000 3.581881070052 0.000000000000
      C 0.000000000000 0.000000000000 6.713000000000
    &END CELL
    &COORD
      SCALED T
      Cd 0.333333333333 0.666666666667 0.000000000000
      Cd 0.666666666667 0.333333333333 0.500000000000
      S 0.333333333333 0.666666666667 0.377150000000
      S 0.666666666667 0.333333333333 0.877150000000
    &END COORD
    &KIND Cd
      BASIS_SET aug-TZVP-MOLOPT-GTH-tier-1-q20
      POTENTIAL GTH-PBE-q20
      POTENTIAL_FILE_NAME POTENTIAL_UZH
    &END KIND
    &KIND S
      BASIS_SET aug-TZVP-MOLOPT-GTH-tier-1
      POTENTIAL GTH-PBE-q6
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
