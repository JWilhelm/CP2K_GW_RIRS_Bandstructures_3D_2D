&GLOBAL
  PROJECT GWOT_GaAs_dz2
  PRINT_LEVEL MEDIUM
  RUN_TYPE ENERGY
&END GLOBAL
&FORCE_EVAL
  METHOD Quickstep
  &DFT
    WFN_RESTART_FILE_NAME /scratch/hpc-prf-metdyn/eprop2d1_Jan/06_CP2K_development/zn_ga_pbe_from_ot_20261018_v1/GaAs/dz2/DIAG_GaAs_dz2_ot_cg-RESTART.kp
    BASIS_SET_FILE_NAME /scratch/hpc-prf-metdyn/eprop2d1_Jan/06_CP2K_development/gaas_cap20_n9_evgw0_20261018_v1/assets/BASIS
    POTENTIAL_FILE_NAME /scratch/hpc-prf-metdyn/eprop2d1_Jan/06_CP2K_development/gaas_cap20_n9_evgw0_20261018_v1/assets/POTENTIALS
    SORT_BASIS EXP
    &POISSON
      PERIODIC XYZ
      POISSON_SOLVER PERIODIC
    &END POISSON
    &KPOINTS
      PARALLEL_GROUP_SIZE -1
      SCHEME MONKHORST-PACK 12 12 12
    &END KPOINTS
    &MGRID
      CUTOFF 1800
      REL_CUTOFF 100
    &END MGRID
    &QS
      EPS_DEFAULT 1.0E-12
      EPS_PGF_ORB 1.0E-12
      METHOD GPW
    &END QS
    &SCF
      ADDED_MOS 0
      EPS_EIGVAL 1.0E-12
      EPS_SCF 1.0E-7
      MAX_SCF 500
      SCF_GUESS RESTART

      &OT ON
        MINIMIZER CG
        PRECONDITIONER FULL_ALL
        ENERGY_GAP 0.001
      &END OT
      &PRINT
        &RESTART ON
        &END RESTART
      &END PRINT
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &PROPERTIES
    &BANDSTRUCTURE
      AO_CONDITION_MAX 3.0E8
      &GW
        NUM_TIME_FREQ_POINTS 32
        FREQ_MAX_FIT 27.211
        CUTOFF_RADIUS_RI 7.5
        RI_CUTOFF_ATTENUATION [bohr^-1] 0.3
        EPS_FILTER 1.0E-10
        RI_METRIC_BODY_CUTOFF 1.0E-10
        GAMMA_3D_ANGULAR_POINTS 14
        &AUTO_RI
          OPTIMIZE_CONDNUM_RI_METRIC TRUE
          RI_AO_RATIO 3.0
          RI_INITIAL -1
        &END AUTO_RI
        &EVGW0
          MAX_ITER 10
          EPS_ITER 5.0E-5
        &END EVGW0
        &RI_RS
          TIKHONOV 1.0E-4
          &GRID_OPTIMIZATION
            CUTOFF_ATOMIC_CLUSTER [angstrom] 3.0
            MAX_ITER 20
            RS_AO_RATIO 6
          &END GRID_OPTIMIZATION
        &END RI_RS
      &END GW
      &BANDSTRUCTURE_PATH
        NPOINTS 32
        SPECIAL_POINT GAMMA 0 0 0
        SPECIAL_POINT X 0 0.5 0.5
        SPECIAL_POINT W 0.25 0.5 0.75
        SPECIAL_POINT K 0.375 0.375 0.75
        SPECIAL_POINT GAMMA 0 0 0
        SPECIAL_POINT L 0.5 0.5 0.5
        SPECIAL_POINT U 0.25 0.625 0.625
        SPECIAL_POINT W 0.25 0.5 0.75
        SPECIAL_POINT L 0.5 0.5 0.5
        SPECIAL_POINT K 0.375 0.375 0.75
      &END BANDSTRUCTURE_PATH
    &END BANDSTRUCTURE
  &END PROPERTIES
  &SUBSYS
    &CELL
      CANONICALIZE F
      A 0.00000000 2.82700000 2.82700000
      B 2.82700000 0.00000000 2.82700000
      C 2.82700000 2.82700000 0.00000000
      PERIODIC XYZ
    &END CELL
    &COORD
      SCALED T
      Ga 0 0 0
      As .25 .25 .25
    &END COORD
    &KIND Ga
      BASIS_SET aug-DZVP-MOLOPT-GTH-tier-2-q21
      POTENTIAL GTH-PBE-q21
    &END KIND
    &KIND As
      BASIS_SET aug-DZVP-MOLOPT-GTH-tier-2
      POTENTIAL GTH-PBE-q5
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
