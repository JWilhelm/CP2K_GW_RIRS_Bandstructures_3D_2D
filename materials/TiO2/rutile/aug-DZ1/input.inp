&GLOBAL
  PROJECT TiO2_rutile_dz1_2n
  PRINT_LEVEL MEDIUM
  RUN_TYPE ENERGY
&END GLOBAL
&FORCE_EVAL
  METHOD Quickstep
  &DFT
    WFN_RESTART_FILE_NAME /scratch/hpc-prf-metdyn/eprop2d1_Jan/06_CP2K_development/tio2_all_gw_scaling_20261020_v1/TiO2_rutile_dz1_2n/SCF_RESTART.kp
    BASIS_SET_FILE_NAME /scratch/hpc-prf-metdyn/eprop2d1_Jan/06_CP2K_development/tio2_all_gw_scaling_20261020_v1/TiO2_rutile_dz1_2n/BASIS
    POTENTIAL_FILE_NAME /scratch/hpc-prf-metdyn/eprop2d1_Jan/06_CP2K_development/tio2_all_gw_scaling_20261020_v1/TiO2_rutile_dz1_2n/POTENTIALS
    SORT_BASIS EXP
    &POISSON
      PERIODIC XYZ
      POISSON_SOLVER PERIODIC
    &END POISSON
    &KPOINTS
      PARALLEL_GROUP_SIZE -1
      SCHEME MONKHORST-PACK 12 12 12
    &END KPOINTS
    &MGRID
      CUTOFF 1800
      REL_CUTOFF 100
    &END MGRID
    &QS
      EPS_DEFAULT 1.0E-12
      EPS_PGF_ORB 1.0E-12
      METHOD GPW
    &END QS
    &SCF
      ADDED_MOS -1
      EPS_EIGVAL 1.0E-12
      EPS_SCF 1.0E-7
      MAX_SCF 500
      SCF_GUESS RESTART
      &MIXING
        METHOD BROYDEN_MIXING
        ALPHA 0.1
        BETA 1.5
        NBROYDEN 8
      &END MIXING
      &PRINT
        &RESTART ON
        &END RESTART
      &END PRINT
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &PROPERTIES
    &BANDSTRUCTURE

      &GW
        NUM_TIME_FREQ_POINTS 32
        FREQ_MAX_FIT 27.211
        CUTOFF_RADIUS_RI 7.5
        RI_CUTOFF_ATTENUATION [bohr^-1] 0.3
        EPS_FILTER 1.0E-10
        RI_METRIC_BODY_CUTOFF 1.0E-10
        GAMMA_3D_ANGULAR_POINTS 14
        &AUTO_RI
          OPTIMIZE_CONDNUM_RI_METRIC TRUE
          RI_AO_RATIO 3.0
          RI_INITIAL -1
        &END AUTO_RI
        &EVGW0
          MAX_ITER 10
          EPS_ITER 5.0E-5
        &END EVGW0
        &RI_RS
          TIKHONOV 1.0E-4
          &GRID_OPTIMIZATION
            CUTOFF_ATOMIC_CLUSTER [angstrom] 3.0
            MAX_ITER 20
            RS_AO_RATIO 6
          &END GRID_OPTIMIZATION
        &END RI_RS
      &END GW
      &BANDSTRUCTURE_PATH
        NPOINTS 32
        SPECIAL_POINT GAMMA 0 0 0
        SPECIAL_POINT X 0.5 0 0
        SPECIAL_POINT M 0.5 0.5 0
        SPECIAL_POINT GAMMA 0 0 0
        SPECIAL_POINT Z 0 0 0.5
        SPECIAL_POINT R 0.5 0 0.5
        SPECIAL_POINT A 0.5 0.5 0.5
        SPECIAL_POINT Z 0 0 0.5
      &END BANDSTRUCTURE_PATH
    &END BANDSTRUCTURE
  &END PROPERTIES
  &SUBSYS
    &CELL
      CANONICALIZE F
      A 4.594000000000 0.000000000000 0.000000000000
      B 0.000000000000 4.594000000000 0.000000000000
      C 0.000000000000 0.000000000000 2.959000000000
      PERIODIC XYZ
    &END CELL
    &COORD
      SCALED T
      Ti 0.000000000000 0.000000000000 0.000000000000
      Ti 0.500000000000 0.500000000000 0.500000000000
      O 0.305000000000 0.305000000000 0.000000000000
      O 0.695000000000 0.695000000000 0.000000000000
      O 0.805000000000 0.195000000000 0.500000000000
      O 0.195000000000 0.805000000000 0.500000000000
    &END COORD
    &KIND Ti
      BASIS_SET aug-DZVP-MOLOPT-GTH-tier-1
      POTENTIAL GTH-PBE-q12
    &END KIND
    &KIND O
      BASIS_SET aug-DZVP-MOLOPT-GTH-tier-1
      POTENTIAL GTH-PBE-q6
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
