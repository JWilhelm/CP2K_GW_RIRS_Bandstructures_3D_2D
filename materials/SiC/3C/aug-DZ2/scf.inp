&GLOBAL
  PROJECT SCF34_dz2_3C-SiC
  PRINT_LEVEL MEDIUM
  RUN_TYPE ENERGY
&END GLOBAL
&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME /scratch/hpc-prf-metdyn/eprop2d1_Jan/06_CP2K_development/gw34_dz12_qcompare_metdyn_6n6h_20261018_v1/runs/3C-SiC/dz2/standard/BASIS
    POTENTIAL_FILE_NAME /scratch/hpc-prf-metdyn/eprop2d1_Jan/06_CP2K_development/gw34_dz12_qcompare_metdyn_6n6h_20261018_v1/runs/3C-SiC/dz2/standard/POTENTIALS
    WFN_RESTART_FILE_NAME /scratch/hpc-prf-metdyn/eprop2d1_Jan/06_CP2K_development/gw34_dz12_qcompare_metdyn_6n6h_20261018_v1/runs/3C-SiC/dz2/standard/SCF_RESTART.kp
    SORT_BASIS EXP
    &POISSON
      PERIODIC XYZ
      POISSON_SOLVER PERIODIC
    &END POISSON
    &KPOINTS
      PARALLEL_GROUP_SIZE -1
      SCHEME MONKHORST-PACK 12 12 12
    &END KPOINTS
    &MGRID
      CUTOFF 1800
      REL_CUTOFF 100
    &END MGRID
    &QS
      EPS_DEFAULT 1.0E-12
      EPS_PGF_ORB 1.0E-12
      METHOD GPW
    &END QS
    &SCF
      ADDED_MOS -1
      EPS_EIGVAL 1.0E-12
      EPS_SCF 1.0E-7
      MAX_SCF 500
      SCF_GUESS RESTART
      &MIXING
        METHOD BROYDEN_MIXING
        ALPHA 0.1
        BETA 1.5
        NBROYDEN 8
      &END MIXING
      &PRINT
        &RESTART ON
        &END RESTART
      &END PRINT
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      CANONICALIZE F
      A 0.00000000 2.17980000 2.17980000
      B 2.17980000 0.00000000 2.17980000
      C 2.17980000 2.17980000 0.00000000
      PERIODIC XYZ
        &END CELL
    &COORD
      SCALED T
      Si 0 0 0
      C .25 .25 .25
        &END COORD
    &KIND Si
      BASIS_SET aug-DZVP-MOLOPT-GTH-tier-2
      POTENTIAL GTH-PBE-q4
    &END KIND
    &KIND C
      BASIS_SET aug-DZVP-MOLOPT-GTH-tier-2
      POTENTIAL GTH-PBE-q4
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
