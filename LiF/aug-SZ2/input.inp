&GLOBAL
  PROJECT LiF_aug-SZ2
  PRINT_LEVEL MEDIUM
  RUN_TYPE ENERGY
&END GLOBAL
&FORCE_EVAL
  &DFT
    BASIS_SET_FILE_NAME BASIS_AUG_MOLOPT_GTH
    POTENTIAL_FILE_NAME GTH_SOC_POTENTIALS
    SORT_BASIS EXP
    &KPOINTS
      SCHEME MONKHORST-PACK 12 12 12
      PARALLEL_GROUP_SIZE -1
    &END KPOINTS
    &MGRID
      CUTOFF 1800
      REL_CUTOFF 100
    &END MGRID
    &QS
      EPS_DEFAULT 1.0E-12
      EPS_PGF_ORB 1.0E-12
    &END QS
    &SCF
      ADDED_MOS -1
      EPS_EIGVAL 1.0E-12
      EPS_SCF 1.0E-7
      MAX_SCF 500
      &MIXING
        METHOD BROYDEN_MIXING
        ALPHA 0.1
        BETA 1.5
        NBROYDEN 8
      &END MIXING
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &PROPERTIES
    &BANDSTRUCTURE
      &GW
        &AUTO_RI
        &END AUTO_RI
        &RI_RS
          &GRID_OPTIMIZATION
          &END GRID_OPTIMIZATION
        &END RI_RS
      &END GW
      &SOC
      &END SOC
      &BANDSTRUCTURE_PATH
        NPOINTS 32
        SPECIAL_POINT GAMMA 0 0 0
        SPECIAL_POINT X 0 0.5 0.5
        SPECIAL_POINT W 0.25 0.5 0.75
        SPECIAL_POINT K 0.375 0.375 0.75
        SPECIAL_POINT GAMMA 0 0 0
        SPECIAL_POINT L 0.5 0.5 0.5
        SPECIAL_POINT U 0.25 0.625 0.625
        SPECIAL_POINT W 0.25 0.5 0.75
        SPECIAL_POINT L 0.5 0.5 0.5
        SPECIAL_POINT K 0.375 0.375 0.75
      &END BANDSTRUCTURE_PATH
    &END BANDSTRUCTURE
  &END PROPERTIES
  &SUBSYS
    &CELL
      CANONICALIZE F
      A 0.000000000000 2.005000000000 2.005000000000
      B 2.005000000000 0.000000000000 2.005000000000
      C 2.005000000000 2.005000000000 0.000000000000
    &END CELL
    &COORD
      SCALED T
      Li 0.000000000000 0.000000000000 0.000000000000
      F 0.500000000000 0.500000000000 0.500000000000
    &END COORD
    &KIND Li
      BASIS_SET aug-SZV-MOLOPT-GTH-tier-2
      POTENTIAL GTH-PBE-q3
    &END KIND
    &KIND F
      BASIS_SET aug-SZV-MOLOPT-GTH-tier-2
      POTENTIAL GTH-PBE-q7
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
