&GLOBAL
  PROJECT WS2_01_aug-SZV_T2_k16
  PRINT_LEVEL MEDIUM
  RUN_TYPE ENERGY
  &TIMINGS
     THRESHOLD 0.0001
  &END
&END GLOBAL
&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME BASIS_AUG_MOLOPT_GTH
    SORT_BASIS EXP
    POTENTIAL_FILE_NAME /scratch/hpc-prf-dyncrys/eprop2d1_Jan/02_Claude/0008_bandstructures_rerun/cases/POTENTIALS_SOC
    CHARGE 0
    &MGRID
      CUTOFF  500
      REL_CUTOFF  100
    &END MGRID
    &POISSON
      PERIODIC XY
      PSOLVER ANALYTIC
    &END POISSON
    &QS
      METHOD GAPW
      EPS_DEFAULT 1.0E-12
      EPS_PGF_ORB 1.0E-12
    &END QS
    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-9
      MAX_SCF 500
      &PRINT
        &RESTART ON
        &END
      &END
      ADDED_MOS -1
      &MIXING
          METHOD BROYDEN_MIXING
          ALPHA 0.1
          BETA 1.5
          NBROYDEN 8
      &END
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
    &KPOINTS
      SCHEME MONKHORST-PACK 16 16 1
      PARALLEL_GROUP_SIZE   -1
    &END KPOINTS
  &END DFT
  &PROPERTIES
    &BANDSTRUCTURE

      &GW
        NUM_TIME_FREQ_POINTS 30
        FREQ_MAX_FIT 27.211
        EPS_FILTER 1.0E-11
        RI_CUTOFF_ATTENUATION [bohr^-1] 0.3
        &AUTO_RI
          RI_AO_RATIO 3.0
        &END AUTO_RI
        &RI_RS
          TIKHONOV 1.0E-4
          &GRID_OPTIMIZATION
            CUTOFF_ATOMIC_CLUSTER [angstrom] 3.0
            MAX_ITER 20
            RS_AO_RATIO 6
          &END GRID_OPTIMIZATION
        &END RI_RS
      &END GW
      &SOC
        SOC_WINDOW_OCC 20
        SOC_WINDOW_VIRT 20
      &END SOC
      &BANDSTRUCTURE_PATH
        NPOINTS 49
        SPECIAL_POINT GAMMA 0.0 0.0 0.0
        SPECIAL_POINT K     0.333333 0.333333 0.0
        SPECIAL_POINT M     0.0 0.5 0.0
        SPECIAL_POINT GAMMA 0.0 0.0 0.0
      &END
    &END
  &END PROPERTIES
  &SUBSYS
    &CELL
      ABC                 3.186 3.186 15.0
      ALPHA_BETA_GAMMA    90 90 120
      PERIODIC XY
    &END CELL
    

    &KIND S
      BASIS_SET ORB aug-SZV-MOLOPT-GTH-tier-2
      POTENTIAL        GTH-PBE-q6
    &END KIND

    &KIND W
      BASIS_SET ORB aug-SZV-MOLOPT-GTH-tier-2
      POTENTIAL        GTH-PBE-q14
    &END KIND


    &COORD
W        0.00000000       0.00000000       9.07279744
S        1.59297297       0.91970338      10.64559488
S        1.59297297       0.91970338       7.50000000
    &END COORD
  &END SUBSYS
&END FORCE_EVAL
